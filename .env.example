# ÇarşıHub — örnek yapılandırma.
# `cp .env.example .env` sonrası hiçbir değişiklik yapmadan çalışır.
# Buradaki parola ve sırlar YALNIZCA yerel geliştirme içindir.

# ── Veritabanı ─────────────────────────────────────────────
POSTGRES_USER=carsihub
POSTGRES_PASSWORD=carsihub_dev_pw
POSTGRES_DB=carsihub
DATABASE_URL=postgres://carsihub:carsihub_dev_pw@db:5432/carsihub?sslmode=disable
DB_MAX_CONNS=50

# ── API ────────────────────────────────────────────────────
API_PORT=8080
LOG_LEVEL=info
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=20s
CORS_ORIGINS=http://localhost:3000

# ── Kimlik doğrulama ───────────────────────────────────────
JWT_SECRET=change-me-dev-only-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
# bcrypt maliyeti; 12 ≈ 250 ms/parola
BCRYPT_COST=12
# HTTPS arkasında true yapın (refresh çerezi yalnızca HTTPS ile gönderilir)
COOKIE_SECURE=false

# ── İş kuralları ───────────────────────────────────────────
# Sepette stok tutma süresi (T-1)
RESERVATION_TTL=15m
# Siparişin ödeme bekleme süresi; dolarsa stok iade edilir
ORDER_PAYMENT_TTL=15m
# Teslimden sonra hakediş vadesi, gün (T-4)
PAYOUT_DELAY_DAYS=14
# Alt sipariş başına satıcıdan kesilen kargo ücreti (kuruş)
SHIPPING_FEE_KURUS=2990
# Çok satıcılı sepette stok yetersizse: allow (kısmi sat) | reject (hepsini reddet)
PARTIAL_FULFILLMENT=allow

# ── Outbox / worker ────────────────────────────────────────
# Süresi dolan rezervasyon ve siparişleri süpürme aralığı
SWEEP_INTERVAL=5s
WORKER_PORT=8081
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=100
# Bu kadar başarısız denemeden sonra olay "dead" olur (metrik: outbox_dead_total)
OUTBOX_MAX_ATTEMPTS=10

# ── Dış bağımlılıklar (T-2) ────────────────────────────────
# API ile ödeme sağlayıcı / kargo firması arasındaki HMAC imza anahtarı (yalnızca geliştirme)
WEBHOOK_SECRET=change-me-dev-only-webhook-secret-32c
PAYMENT_PROVIDER_URL=http://simulator:8090
CARRIER_URL=http://simulator:8090
# Dış sistemlerin callback için API'ye ulaştığı adres
PUBLIC_BASE_URL=http://api:8080
# Callback'i bu kadar gecikmiş ödeme sağlayıcıya sorulur (mutabakat)
PAYMENT_RECONCILE_AFTER=10s

# ── Simülatör ──────────────────────────────────────────────
# Aynı tohum → aynı veri
SIM_SEED=42
SIM_PORT=8090
SIM_PRODUCTS=1000000
SIM_SELLERS=5000
# Ödeme hata oranları (kuruş hanesiyle deterministik senaryolar için bkz. TESTING.md)
SIM_PAYMENT_DECLINE_RATE=0.05
SIM_PAYMENT_TIMEOUT_RATE=0.05
SIM_PAYMENT_DUP_CALLBACK_RATE=0.05
SIM_PAYMENT_LATENCY=1s
# Kargo olayları arası süre (alındı → yolda → teslim edildi)
SIM_SHIPMENT_STEP=3s

# ── Frontend ───────────────────────────────────────────────
VITE_API_URL=http://localhost:8080
