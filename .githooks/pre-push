#!/bin/sh
# Push'tan önce testler: kırık kod uzak depoya gitmesin.
# Acil durumda atlamak için: git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"

echo "▶ backend testleri"
(cd backend && go test ./...)

echo "▶ frontend tip kontrolü ve testler"
(cd frontend && npm run --silent typecheck && npm test --silent)

echo "✓ testler geçti, push ediliyor"
