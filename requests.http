# VS Code REST Client koleksiyonu. Önce: docker compose up --build
# Demo hesapları ve parolalar: TESTING.md
@api = http://localhost:8080
@v1 = {{api}}/api/v1

### Sağlık
GET {{api}}/health

### Metrikler
GET {{api}}/metrics

### Bilinmeyen uç → standart hata gövdesi
GET {{v1}}/olmayan-uc

# ── Kimlik doğrulama ─────────────────────────────────────

### Yönetici girişi
# @name admin
POST {{v1}}/auth/login
Content-Type: application/json

{"email": "yonetici@carsihub.test", "password": "Demo123!"}

### Müşteri girişi
# @name customer
POST {{v1}}/auth/login
Content-Type: application/json

{"email": "musteri@carsihub.test", "password": "Demo123!"}

### Yanlış parola → 401 invalid_credentials
POST {{v1}}/auth/login
Content-Type: application/json

{"email": "musteri@carsihub.test", "password": "yanlis"}

### Geçersiz girdi → 422, alan bazlı hata
POST {{v1}}/auth/login
Content-Type: application/json

{"email": "bozuk", "password": ""}

### Oturum sahibi
GET {{v1}}/auth/me
Authorization: Bearer {{admin.response.body.access_token}}

### Token'sız → 401
GET {{v1}}/auth/me

### Refresh token döndürme (ikinci kez çalıştırınca 401 token_reused)
POST {{v1}}/auth/refresh
Content-Type: application/json

{"refresh_token": "{{customer.response.body.refresh_token}}"}

### Çıkış
POST {{v1}}/auth/logout
Content-Type: application/json

{"refresh_token": "{{admin.response.body.refresh_token}}"}

# ── Yönetici ─────────────────────────────────────────────

### Kullanıcı listesi (keyset sayfalama; next_cursor ile devam)
GET {{v1}}/admin/users?limit=2
Authorization: Bearer {{admin.response.body.access_token}}

### Müşteri yönetici ucuna → 403
GET {{v1}}/admin/users
Authorization: Bearer {{customer.response.body.access_token}}

# ── Katalog ve stok (F-1, F-2, F-3, T-1) ─────────────────

### Satıcı girişi
# @name seller
POST {{v1}}/auth/login
Content-Type: application/json

{"email": "satici@carsihub.test", "password": "Demo123!"}

### Kategoriler
GET {{v1}}/categories
Authorization: Bearer {{customer.response.body.access_token}}

### Ürün listesi (en düşük fiyat + satılabilir stok)
GET {{v1}}/products?limit=20
Authorization: Bearer {{customer.response.body.access_token}}

### Satıcı ürün ekler (varyant + kendi fiyatı + stoğu). SKU'yu her denemede değiştirin.
# @name newProduct
POST {{v1}}/seller/products
Authorization: Bearer {{seller.response.body.access_token}}
Content-Type: application/json

{
  "category_id": 1,
  "name": "Keten Gömlek",
  "description": "Yazlık",
  "variants": [
    {"sku": "GMLK-KTN-M-1", "attributes": {"beden": "M"}, "price_kurus": 59990, "stock": 5},
    {"sku": "GMLK-KTN-L-1", "attributes": {"beden": "L"}, "price_kurus": 59990, "stock": 1}
  ]
}

### Ürün ayrıntısı: varyantlar ve satıcı teklifleri
GET {{v1}}/products/{{newProduct.response.body.id}}
Authorization: Bearer {{customer.response.body.access_token}}

### Satıcının kendi teklifleri (stok / rezerve / satılabilir)
GET {{v1}}/seller/offers?limit=20
Authorization: Bearer {{seller.response.body.access_token}}

### Stok güncelle (tutulan miktarın altına inemez → 409 below_reserved)
PUT {{v1}}/seller/offers/{{newProduct.response.body.variants[0].offers[0].id}}/stock
Authorization: Bearer {{seller.response.body.access_token}}
Content-Type: application/json

{"stock_on_hand": 8}

### Sepete ekle (stok RESERVATION_TTL boyunca tutulur). Aynı Idempotency-Key ile tekrar → aynı yanıt
POST {{v1}}/cart/items
Authorization: Bearer {{customer.response.body.access_token}}
Content-Type: application/json
Idempotency-Key: sepet-ornek-1

{"offer_id": "{{newProduct.response.body.variants[0].offers[0].id}}", "quantity": 2}

### Sepet (reserved_until: stoğun ne zamana kadar tutulduğu)
GET {{v1}}/cart
Authorization: Bearer {{customer.response.body.access_token}}

### Sepetten sipariş: satıcı başına alt sipariş
# @name checkout
POST {{v1}}/cart/checkout
Authorization: Bearer {{customer.response.body.access_token}}
Idempotency-Key: odeme-ornek-1

### Doğrudan sipariş; stok yetmezse 409 insufficient_stock + unavailable_items
POST {{v1}}/orders
Authorization: Bearer {{customer.response.body.access_token}}
Content-Type: application/json
Idempotency-Key: siparis-ornek-1

{"items": [
  {"offer_id": "{{newProduct.response.body.variants[0].offers[0].id}}", "quantity": 1},
  {"offer_id": "{{newProduct.response.body.variants[1].offers[0].id}}", "quantity": 5}
]}

### Siparişlerim
GET {{v1}}/orders
Authorization: Bearer {{customer.response.body.access_token}}

### Sipariş ayrıntısı
GET {{v1}}/orders/{{checkout.response.body.id}}
Authorization: Bearer {{customer.response.body.access_token}}

### İptal (yalnızca ödeme bekleyen; stok iade edilir)
POST {{v1}}/orders/{{checkout.response.body.id}}/cancel
Authorization: Bearer {{customer.response.body.access_token}}

### Satıcı sepete ekleyemez → 403
POST {{v1}}/cart/items
Authorization: Bearer {{seller.response.body.access_token}}
Content-Type: application/json

{"offer_id": "{{newProduct.response.body.variants[0].offers[0].id}}", "quantity": 1}

# ── Ödeme ve kargo (F-4, F-6, T-2) ───────────────────────
# Sipariş toplamının kuruş hanesi simülatörün davranışını seçer (TESTING.md):
# ,01 ret · ,02 callback kaybolur · ,03 çift callback · ,04 askıda · ,05 başarılı

### Fiyatı ,05 ile biten ürün (ödeme başarılı olacak)
# @name sagaProduct
POST {{v1}}/seller/products
Authorization: Bearer {{seller.response.body.access_token}}
Content-Type: application/json

{"category_id": 1, "name": "Saga deneme", "variants": [{"sku": "SAGA-1", "price_kurus": 12305, "stock": 10}]}

### Sipariş ver; ödeme ve kargo kendiliğinden ilerler
# @name sagaOrder
POST {{v1}}/orders
Authorization: Bearer {{customer.response.body.access_token}}
Content-Type: application/json
Idempotency-Key: saga-ornek-1

{"items": [{"offer_id": "{{sagaProduct.response.body.variants[0].offers[0].id}}", "quantity": 1}]}

### Saga durumu: payment.status ve sub_orders[].shipment (birkaç saniyede bir tekrar çalıştırın)
GET {{v1}}/orders/{{sagaOrder.response.body.id}}
Authorization: Bearer {{customer.response.body.access_token}}

### Kargo takibi (tracking_number'ı yukarıdaki yanıttan alın)
GET {{v1}}/shipments/TRK0000000000
Authorization: Bearer {{customer.response.body.access_token}}

### Satıcı bildirimleri
GET {{v1}}/seller/notifications
Authorization: Bearer {{seller.response.body.access_token}}

### Kargo entegrasyonu girişi
# @name carrier
POST {{v1}}/auth/login
Content-Type: application/json

{"email": "kargo@carsihub.test", "password": "Demo123!"}

### Kargo rolü elle olay girer (Idempotency-Key = olay kimliği)
POST {{v1}}/carrier/shipments/TRK0000000000/events
Authorization: Bearer {{carrier.response.body.access_token}}
Content-Type: application/json
Idempotency-Key: elle-olay-1

{"status": "in_transit"}

### Operasyon girişi
# @name ops
POST {{v1}}/auth/login
Content-Type: application/json

{"email": "operasyon@carsihub.test", "password": "Demo123!"}

### Outbox durumu (bekleyen / yeniden denenen / bırakılmış)
GET {{v1}}/ops/outbox
Authorization: Bearer {{ops.response.body.access_token}}

### İmzasız ödeme callback'i → 401 invalid_signature
# (Gerçek callback'ler simülatörden HMAC imzasıyla gelir; elle imzalamak gerekmez.)
POST {{v1}}/payments/callback
Content-Type: application/json

{"payment_id": "00000000-0000-0000-0000-000000000000", "status": "succeeded"}

# ── Kupon ve fiyat motoru (T-3) ──────────────────────────
# Demo kuponlar: PAZAR50, YUZDE10, DEMOGIYIM20, ILK100 (kurallar TESTING.md)

### Yönetici pazaryeri kuponu açar (kapsam rolden gelir)
POST {{v1}}/coupons
Authorization: Bearer {{admin.response.body.access_token}}
Content-Type: application/json

{"code": "HAFTASONU30", "kind": "fixed", "value": 3000, "min_basket_kurus": 20000, "max_redemptions": 500, "per_user_limit": 1}

### Satıcı kendi mağazası için kupon açar
POST {{v1}}/coupons
Authorization: Bearer {{seller.response.body.access_token}}
Content-Type: application/json

{"code": "MAGAZAM15", "kind": "percent", "value": 1500, "max_discount_kurus": 20000}

### Kuponlar (satıcı yalnızca kendininkileri görür)
GET {{v1}}/coupons
Authorization: Bearer {{seller.response.body.access_token}}

### Sepete kupon ekle (bilinmeyen kod → 404, süresi geçmiş → 422)
POST {{v1}}/cart/coupons
Authorization: Bearer {{customer.response.body.access_token}}
Content-Type: application/json

{"code": "pazar50"}

### Sepet: applied_coupons, rejected_coupons (nedenleriyle), satır bazında indirim
GET {{v1}}/cart
Authorization: Bearer {{customer.response.body.access_token}}

### Kuponu sepetten çıkar
DELETE {{v1}}/cart/coupons/PAZAR50
Authorization: Bearer {{customer.response.body.access_token}}

### Doğrudan siparişte kupon
POST {{v1}}/orders
Authorization: Bearer {{customer.response.body.access_token}}
Content-Type: application/json

{"items": [{"offer_id": "{{newProduct.response.body.variants[0].offers[0].id}}", "quantity": 1}], "coupon_codes": ["YUZDE10", "PAZAR50"]}

### Kısmi iade önizlemesi (yalnızca ödenmiş sipariş; order_item_id sipariş ayrıntısından)
POST {{v1}}/orders/{{sagaOrder.response.body.id}}/refund-quote
Authorization: Bearer {{customer.response.body.access_token}}
Content-Type: application/json

{"items": [{"order_item_id": "00000000-0000-0000-0000-000000000000", "quantity": 1}]}
